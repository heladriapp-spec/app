# Nomes apenas. Os valores ficam em .env.local, fora do Git.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APP_AMBIENTE=desenvolvimento

# Assina o cookie de sessão. Valor longo e aleatório, distinto da chave do Supabase.
# Sem este valor, o desenvolvimento usa data/segredo-sessao.
SEGREDO_SESSAO=

# Remetente SMTP. Não é add-on da Vercel. Sem estes valores o e-mail não sai.
SMTP_HOST=
SMTP_PORT=587
SMTP_SEGURO=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
APP_URL=
